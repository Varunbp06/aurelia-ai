# Browser-visible API base. Leave empty to use same-origin requests through Next.js rewrites / nginx.
# Vercel: leave empty and set BACKEND_PROXY_TARGET to your deployed backend URL.
NEXT_PUBLIC_API_BASE_URL=

# Browser-visible WebSocket base (admin sessions realtime). Leave empty for same-origin wss://.
NEXT_PUBLIC_WS_BASE_URL=

# Server-side proxy target used by Next.js rewrites.
# Local dev container: http://backend-dev:8000 — Vercel: https://your-backend.example.com
BACKEND_PROXY_TARGET=http://localhost:8000
